---
import relationships from '../data/relationships.json';
import slugmap from '../data/slugmap.json';

interface Props {
  slug: string;
  coll: string;
}

const { slug, coll } = Astro.props;

const urlLookup = new Map(
  slugmap.items.map((i: { slug: string; urls: string[] }) => [i.slug, i.urls])
);

let inGraph = false;
const related = new Set<string>();
for (const r of relationships.items) {
  if (r.from === slug) {
    inGraph = true;
    related.add(r.to);
  }
  if (r.to === slug) {
    inGraph = true;
    related.add(r.from);
  }
}
related.delete(slug);
const relatedLinks = [...related]
  .map((s) => ({ slug: s, urls: urlLookup.get(s) || [] }))
  .filter((x) => x.urls.length > 0)
  .sort((a, b) => a.slug.localeCompare(b.slug));
---

{inGraph && (
  <div class="card">
    <h2>Knowledge graph</h2>
    <p class="meta">
      Data record: <a href={`https://data.daoismhub.com/graph/entities/${slug}/`}>{slug}</a> in the{' '}
      <a href="https://data.daoismhub.com/">Data Registry</a> — relationships, incoming and outgoing.
    </p>
    {relatedLinks.length > 0 && (
      <p class="meta">
        Related: {relatedLinks.map((l, i) => (
          <>
            {i > 0 && <span> · </span>}
            <a href={l.urls[0]}>{l.slug}</a>
          </>
        ))}
      </p>
    )}
  </div>
)}
<p class="meta">
  See all {coll} records in the <a href={`https://data.daoismhub.com/entities/${coll}/`}>Data Registry</a>.
</p>
