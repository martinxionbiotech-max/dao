---
import Base from '../../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('questions');
  return entries
    .filter((e) => e.data.status !== 'draft' && e.data.status !== 'internal')
    .map((e) => ({ params: { slug: e.id.replace(/\.md$/, '') }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<Base title={d.question} description={d.description} published={d.date} updated={d.updated}>
  <h1>{d.question}</h1>
  {d.date && <p class="meta">Published {d.date.toISOString().slice(0, 10)} &middot; Updated {(d.updated || d.date).toISOString().slice(0, 10)}</p>}
  <p class="meta"><span class="tag">{d.answerState}</span></p>
  <Content />
</Base>
