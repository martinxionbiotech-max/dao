---
import Base from '../../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('experiences');
  return entries
    .filter((e) => e.data.sourceType === 'report' && e.data.status !== 'draft' && e.data.status !== 'internal')
    .map((e) => ({ params: { slug: e.id.replace(/\.md$/, '') }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const detail = [
  ['Practice', d.practice], ['Tradition', d.tradition], ['Practice duration', d.practiceDuration],
  ['Session duration', d.sessionDuration], ['Frequency', d.frequency], ['Context', d.context],
  ['Trigger', d.trigger], ['Physical', d.physical], ['Breathing', d.breathing],
  ['Attention', d.attention], ['Cognitive', d.cognitive], ['Emotional', d.emotional],
  ['Perception', d.perception], ['After-effects', d.afterEffects], ['Difficulty', d.difficulty],
].filter(([, v]) => v);
---

<Base title={d.title} description={d.description}>
  <h1>{d.title}</h1>
  <p class="meta"><span class="tag">experience report</span><span class="tag">{d.anonymity}</span>{d.confidence && <span class="tag">confidence: {d.confidence}</span>}</p>
  <Content />
  {detail.length > 0 && (
    <>
      <h2>Structured record</h2>
      <table><tbody>
        {detail.map(([k, v]) => <tr><th>{k}</th><td>{v}</td></tr>)}
      </tbody></table>
    </>
  )}
  {(d.practitionerInterpretation || d.traditionalInterpretation || d.alternativeInterpretation) && (
    <>
      <h2>Interpretations</h2>
      {d.practitionerInterpretation && <p><strong>Practitioner:</strong> {d.practitionerInterpretation}</p>}
      {d.traditionalInterpretation && <p><strong>Traditional:</strong> {d.traditionalInterpretation}</p>}
      {d.alternativeInterpretation && <p><strong>Alternative:</strong> {d.alternativeInterpretation}</p>}
    </>
  )}
  <p class="meta" style="margin-top:18px;">
    Recorded as anonymized practitioner or community observation — not an endorsement. Health-related
    statements are the speakers' lay claims; see the{' '}
    <a href="/experiences/questions/can-meditation-cure-illness/">health-claims rule</a> and the{' '}
    <a href="/disclaimer/">disclaimer</a>. Not medical advice.
  </p>
</Base>
