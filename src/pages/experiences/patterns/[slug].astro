---
import Base from '../../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('patterns');
  return entries
    .filter((e) => e.data.status !== 'draft' && e.data.status !== 'internal')
    .map((e) => ({ params: { slug: e.id.replace(/\.md$/, '') }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<Base title={d.title} description={d.description} published={d.date} updated={d.updated}>
  <h1>{d.title}</h1>
  {d.date && <p class="meta">Published {d.date.toISOString().slice(0, 10)} &middot; Updated {(d.updated || d.date).toISOString().slice(0, 10)}</p>}
  <p class="meta"><span class="tag">experience pattern</span><span class="tag">{d.evidenceBasis}</span>{d.reportCount != null && <span class="tag">{d.reportCount} reports</span>}</p>
  <Content />
  <p class="meta" style="margin-top:18px;">
    Patterns aggregate anonymized reports — recorded, not endorsed. Health-related statements are lay claims;
    see the{' '}
    <a href="/experiences/questions/can-meditation-cure-illness/">health-claims rule</a> and the{' '}
    <a href="/disclaimer/">disclaimer</a>. Not medical advice.
  </p>
</Base>
