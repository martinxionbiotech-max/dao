---
import Base from '../layouts/Base.astro';
import concepts from '../data/concepts.json';
import practices from '../data/practices.json';
import experiences from '../data/experiences.json';
import patterns from '../data/patterns.json';
import relationships from '../data/relationships.json';
import sources from '../data/sources.json';
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Dao Knowledge Base',
  url: 'https://daoismhub.com/',
  description:
    'A structured English-language knowledge system for Chinese contemplative traditions — Daoism, Chan Buddhism, and related self-cultivation — with typed entities, relationships and sources.',
  inLanguage: 'en',
};
---

<Base
  title=""
  description="An English-language knowledge infrastructure for understanding Chinese contemplative traditions — Daoism, Chan Buddhism, and related self-cultivation — through texts, history, concepts, practices, research and anonymized practitioner experience."
>
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <h1>Chinese Contemplative Traditions</h1>
  <p class="lede">
    A structured knowledge system — not a blog — for understanding Daoism, Chan/Zen
    Buddhism, and Chinese self-cultivation through texts, history, concepts, practices,
    modern research, and real practitioner experience.
  </p>

  <p class="meta">
    {concepts.items.length} concepts &middot; {practices.items.length} practices &middot;
    {experiences.items.length} practitioner records &middot; {relationships.items.length} typed
    knowledge-graph relationships &middot; {sources.items.length} sources. Live counts, generated from the
    same data files that power the <a href="https://data.daoismhub.com/">Data Registry</a>.
  </p>

  <h2>How knowledge moves here</h2>
  <p>
    Every page is built to connect:
    <em>Question → Experience → Practice → Concept → Tradition → Text → Historical
    context → Modern research → Editorial synthesis.</em>
    Claims carry explicit evidence classes; primary sources, scholarly interpretation,
    practitioner reports and editorial analysis are never conflated.
  </p>

  <h2>Start where you are</h2>
  <div class="grid">
    <div class="card">
      <h2><a href="/experiences/questions/">I have a question</a></h2>
      <p>Real questions from practitioners — posture, sleepiness, progress, safety — each answered with what the evidence does and does not support.</p>
    </div>
    <div class="card">
      <h2><a href="/practices/">I want to understand a practice</a></h2>
      <p>Zuowang, Neiguan, Jingzuo, Cunxiang, Qigong, Neidan — origins, instructions, textual evidence, and what modern research cannot confirm.</p>
    </div>
    <div class="card">
      <h2><a href="/concepts/">I want to learn the concepts and classics</a></h2>
      <p>Dao, Wuwei, Xinzhai, the Daodejing, the Zhuangzi — Chinese terms, pinyin, translations, and the contested history behind them.</p>
    </div>
    <div class="card">
      <h2><a href="/research/">I want the modern evidence</a></h2>
      <p>Meditation and contemplative research reviewed with methods, limitations, and clear boundaries — what studies show, and what they do not prove.</p>
    </div>
    <div class="card">
      <h2><a href="https://data.daoismhub.com/">I want the machine-readable data</a></h2>
      <p>The Data Registry: entities, typed relationships, the source registry, schemas and a graph explorer — all publicly queryable.</p>
    </div>
  </div>

  <h2>Explore</h2>
  <div class="grid">
    <div class="card">
      <h2><a href="/concepts/">Concepts</a></h2>
      <p>Zuowang, Wu Wei, Neiguan, Shouyi and the core ideas of the traditions.</p>
    </div>
    <div class="card">
      <h2><a href="/practices/">Practices</a></h2>
      <p>Zuowang, Neiguan, Cunxiang, Jingzuo, Qigong, Neidan — with origins, instructions and textual evidence.</p>
    </div>
    <div class="card">
      <h2><a href="/problems/">Problems</a></h2>
      <p>Real difficulties meditators report: subtle breathing, numbness, sleepiness, loud thoughts.</p>
    </div>
    <div class="card">
      <h2><a href="/comparisons/">Comparisons</a></h2>
      <p>Zuowang vs mindfulness, Neiguan vs Vipassana, Daoist vs Chan meditation.</p>
    </div>
    <div class="card">
      <h2><a href="/texts/">Texts</a></h2>
      <p>Zhuangzi, Daodejing, Qingjing Jing, Neiguan Jing — original, translations, context.</p>
    </div>
    <div class="card">
      <h2><a href="/glossary/">Glossary</a></h2>
      <p>A Chinese contemplative dictionary: characters, pinyin, translation options, misunderstandings.</p>
    </div>
    <div class="card">
      <h2><a href="/research/">Research</a></h2>
      <p>Modern meditation research reviewed with methods, limitations, and what it does not prove.</p>
    </div>
    <div class="card">
      <h2><a href="/experiences/">Experiences</a></h2>
      <p>Anonymized practitioner reports, recurring patterns, and real questions — separated from scientific evidence.</p>
    </div>
    <div class="card">
      <h2><a href="/people/">People</a></h2>
      <p>Laozi, Zhuangzi, Ge Hong, Wang Chongyang — history, tradition and legend kept apart.</p>
    </div>
    <div class="card">
      <h2><a href="/timeline/">Timeline</a></h2>
      <p>The historical development of Chinese contemplative traditions.</p>
    </div>
  </div>

  <h2>Editorial principles</h2>
  <div class="card">
    <ul>
      <li><strong>No invented certainty.</strong> Every claim is classified: primary source, historical evidence, scholarly interpretation, tradition, research, practitioner experience, or editorial synthesis.</li>
      <li><strong>No hallucinations.</strong> Books, quotations, texts, studies and experiences are never fabricated; legends stay legends.</li>
      <li><strong>Practitioner material is evidence, not content farm filler.</strong> Raw community material is cleaned, anonymized, structured and routed — and only published when it creates, connects, corrects or deepens knowledge.</li>
    </ul>
  </div>
</Base>
