---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('timeline'))
  .filter((e) => e.data.status === 'published')
  .sort((a, b) => (a.data.title || '').localeCompare(b.data.title || ''));
---

<Base title="Timeline" description="The historical development of Chinese contemplative traditions.">
  <h1>Timeline</h1>
  <p class="lede">The historical development of Chinese contemplative traditions.</p>
  <p class="meta">{entries.length} published entr{entries.length === 1 ? 'y' : 'ies'}</p>
  {entries.length === 0 && (
    <p class="meta">Content is being researched and will be published here.</p>
  )}
  {entries.map((e) => (
    <div class="card">
      <h2><a href={`/timeline/${e.id.replace(/\.md$/, '')}/`}>{e.data.title}</a></h2>
      {e.data.description && <p>{e.data.description}</p>}
      <p class="meta">
        {e.data.evidence?.map((v) => <span class="tag">{v}</span>)}
      </p>
    </div>
  ))}
</Base>
