---
import Base from '../../layouts/Base.astro';
import EntityFooter from '../../components/EntityFooter.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('concepts');
  return entries
    .filter((e) => e.data.status !== 'draft' && e.data.status !== 'internal')
    .map((e) => ({ params: { slug: e.id.replace(/\.md$/, '') }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const ev = (d.evidence || []).length ? d.evidence : undefined;
const slug = entry.id.replace(/\.md$/, '');
const definedTermSchema = d.description ? {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  name: d.title,
  description: d.description,
  termCode: slug,
  inDefinedTermSet: {
    '@type': 'DefinedTermSet',
    name: 'DaoismHub Concepts',
    url: 'https://daoismhub.com/concepts/',
  },
} : null;
---

<Base title={d.title} description={d.description}>
  {definedTermSchema && <script type="application/ld+json" set:html={JSON.stringify(definedTermSchema)} />}
  <h1>{d.title}</h1>
  {d.description && <p class="lede">{d.description}</p>}
  {(d.chinese || d.pinyin || d.tradition || d.period || d.dynasty || d.author) && (
    <p class="meta">
      {d.chinese && <span>中文: {d.chinese} &middot; </span>}
      {d.pinyin && <span>{d.pinyin} &middot; </span>}
      {d.tradition && <span>{d.tradition} &middot; </span>}
      {d.period && <span>{d.period} &middot; </span>}
      {d.dynasty && <span>{d.dynasty} &middot; </span>}
      {d.author && <span>{d.author}</span>}
    </p>
  )}
  {ev && <p class="meta">{ev.map((v) => <span class="tag">{v}</span>)}</p>}
  <Content />
  <EntityFooter slug={slug} coll="concepts" />
  {(d.sources?.length > 0) && (
    <>
      <h2>Sources</h2>
      <ul>{d.sources.map((s) => <li>{s}</li>)}</ul>
    </>
  )}
</Base>
