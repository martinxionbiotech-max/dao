---
import Base from '../../layouts/Base.astro';
import concepts from '../../data/concepts.json';
import practices from '../../data/practices.json';
import experiences from '../../data/experiences.json';
import patterns from '../../data/patterns.json';
import relationships from '../../data/relationships.json';
import sources from '../../data/sources.json';
---

<Base title="Data" description="Machine-readable JSON datasets behind the knowledge graph: concepts, practices, experiences, patterns, relationships and sources, each traced to a page.">
  <h1>Structured Data</h1>
  <p class="lede">
    Machine-readable JSON datasets behind the knowledge graph. Every entry links back to
    authored pages and carries an evidence class. The <a href="https://data.daoismhub.com/">Data
    Registry</a> publishes these files as browsable registries: entities, typed relationships,
    sources, schemas and a graph explorer.
  </p>
  <p class="meta">Dataset snapshot from git history: 2026-10-10 (all registry JSON files).</p>

  <p>
    Each dataset is a flat JSON file with one record per entity, a stable identifier, an evidence
    class and links back to the authored page it came from. The files are published for reuse:
    quote them with the page URL and the snapshot date above, because the registry is versioned in
    git rather than served live. What the datasets do not contain is equally deliberate — no
    practitioner identities, no teacher lineage claims that cannot be documented, and no derived
    scores that would imply a measurement the sources do not support.
  </p>
  <div class="grid">
    <div class="card"><h2>Concepts</h2><p class="meta">{concepts.items.length} records</p></div>
    <div class="card"><h2>Practices</h2><p class="meta">{practices.items.length} records</p></div>
    <div class="card"><h2>Experiences</h2><p class="meta">{experiences.items.length} records</p></div>
    <div class="card"><h2>Patterns</h2><p class="meta">{patterns.items.length} records</p></div>
    <div class="card"><h2>Relationships</h2><p class="meta">{relationships.items.length} records</p></div>
    <div class="card"><h2>Sources</h2><p class="meta">{sources.items.length} records</p></div>
  </div>
</Base>
