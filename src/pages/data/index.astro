---
import Base from '../../layouts/Base.astro';
import concepts from '../../data/concepts.json';
import practices from '../../data/practices.json';
import experiences from '../../data/experiences.json';
import patterns from '../../data/patterns.json';
import relationships from '../../data/relationships.json';
import sources from '../../data/sources.json';
---

<Base title="Data" description="Structured datasets powering the knowledge graph.">
  <h1>Structured Data</h1>
  <p class="lede">
    Machine-readable JSON datasets behind the knowledge graph. Every entry links back to
    authored pages and carries an evidence class.
  </p>
  <div class="grid">
    <div class="card"><h2>Concepts</h2><p class="meta">{concepts.items.length} records</p></div>
    <div class="card"><h2>Practices</h2><p class="meta">{practices.items.length} records</p></div>
    <div class="card"><h2>Experiences</h2><p class="meta">{experiences.items.length} records</p></div>
    <div class="card"><h2>Patterns</h2><p class="meta">{patterns.items.length} records</p></div>
    <div class="card"><h2>Relationships</h2><p class="meta">{relationships.items.length} records</p></div>
    <div class="card"><h2>Sources</h2><p class="meta">{sources.items.length} records</p></div>
  </div>
</Base>
