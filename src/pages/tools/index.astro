---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('tools'))
  .filter((e) => e.data.status === 'published')
  .sort((a, b) => (a.data.title || '').localeCompare(b.data.title || ''));
---

<Base title="Tools" description="Explorers and interfaces into the structured knowledge base.">
  <h1>Tools</h1>
  <p class="lede">Explorers and interfaces into the structured knowledge base.</p>
  <p class="meta">{entries.length} published entr{entries.length === 1 ? 'y' : 'ies'}</p>
  {entries.length === 0 && (
    <p class="meta">Content is being researched and will be published here.</p>
  )}
  {entries.map((e) => (
    <div class="card">
      <h2><a href={`/%s/${e.id}/`}>{e.data.title}</a></h2>
      {e.data.description && <p>{e.data.description}</p>}
      <p class="meta">
        {e.data.evidence?.map((v) => <span class="tag">{v}</span>)}
      </p>
    </div>
  ))}
</Base>
